# --- Local scraper testing only ---
# The scraper (scraping/) now runs in GitHub Actions, not a local server -- this
# .env is only read when you run `python -m scraping.push_adapter` locally to
# test a scrape against a real (or local `wrangler dev`) Worker. In GitHub
# Actions, the same variables are set as repo secrets instead -- see DEPLOY.md.
SERPER_API_KEY=replace-with-your-serper-api-key
SPRINGR_WORKER_URL=http://127.0.0.1:8787
SPRINGR_INGEST_SECRET=replace-with-a-generated-secret

# Everything else (Google OAuth client id/secret, session signing secret, admin
# emails, the Worker's own copy of the ingest secret) is a Cloudflare Worker
# secret set via `wrangler secret put <NAME>`, not an env file -- see
# worker/wrangler.toml's comment block and DEPLOY.md for the full list.
