# --- Scraper ---
SERPER_API_KEY=replace-with-your-serper-api-key
SPRINGR_DB=./springr.db
SPRINGR_REFRESH_HOURS=6
SPRINGR_PORT=4173

# --- Flask / sessions ---
# development enables Flask's debug/reload mode and allows the session cookie to be
# sent over plain http:// (needed for local testing at 127.0.0.1). Leave unset (or
# set to anything else) in production -- see DEPLOY.md.
FLASK_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-generated-secret

# --- Google OAuth ---
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# (Web application). See DEPLOY.md for the exact steps and required redirect URIs.
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret

# Comma-separated list of Google account emails that should be treated as admins
# (able to trigger /api/discover manually). Matched at login time.
ADMIN_EMAILS=you@example.com

# Set to 1 on exactly one deployed instance so the background scheduler (periodic
# re-scrape) runs once, not once per instance. Defaults to 1 -- set to 0 on any
# extra instance if you ever run more than one.
RUN_SCHEDULER=1

# --- Optional email alerts on opportunity status changes ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=
