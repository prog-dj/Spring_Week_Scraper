{
  "name": "springr-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute springr --local --file=./src/db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute springr --remote --file=./src/db/schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "@sentry/cloudflare": "^10.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "typescript": "^5.6.0",
    "@cloudflare/workers-types": "^5.0.0"
  }
}
